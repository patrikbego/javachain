<?xml version="1.0"?>
<!-- Review-only helper: redirect all repositories to Maven Central,
     because the pom's spring-release repo rejects anonymous downloads today. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <mirrors>
    <mirror>
      <id>central-force</id>
      <mirrorOf>*</mirrorOf>
      <name>Maven Central</name>
      <url>https://repo1.maven.org/maven2</url>
    </mirror>
  </mirrors>
</settings>
